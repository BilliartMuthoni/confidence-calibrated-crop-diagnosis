APP_NAME=Sproutly
APP_ENV=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DATABASE_URL=

# Browser origins allowed to call the API (JSON list). Default: the admin app dev server.
CORS_ORIGINS=["http://localhost:5173"]

# Trained model from Google Drive: CropDiseaseDiagnosis/models/compare_resnet50/model.pt
# (ResNet-50, chosen in #41; not in Git). Path is relative to sproutly-backend/.
# Any model from the architecture comparison loads; change this path to switch.
ML_MODEL_PATH=models/compare_resnet50/model.pt
# Calibration (notebook 13): scores are divided by this before softmax. 1.0 = no calibration.
TEMPERATURE=3.04
# Below this calibrated confidence the farmer is referred instead of diagnosed (notebook 13b; never below 0.5).
CONFIDENCE_THRESHOLD=0.877

# Admin portal: where one-time password links for staff point, how long they work, and staff sessions.
ADMIN_PORTAL_URL=http://localhost:5173
STAFF_LINK_EXPIRE_HOURS=48
STAFF_SESSION_MINUTES=480
# Wrong passwords or codes in a row before an account is locked, and for how many minutes.
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Days an officer has to answer a referral.
REFERRAL_DAYS=7
# Farmers' photos are deleted this many days after the check (the result stays). Must be longer than REFERRAL_DAYS.
PHOTO_DAYS=30

UPLOAD_DIR=uploads

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Encrypts each user's authenticator secret in the database. Changing it locks
# every user out of MFA, so set it once and keep it out of Git.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
# Name shown next to the codes in Google Authenticator / Microsoft Authenticator.
TOTP_ISSUER=Sproutly
# How long the app has between the password step and the code step.
MFA_TOKEN_EXPIRE_MINUTES=5
MFA_SETUP_TOKEN_EXPIRE_MINUTES=10

# Continue with Google. Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application), redirect URI <https address>/auth/oauth/google/callback. Google only accepts
# https (or localhost), so on a phone this needs PUBLIC_BASE_URL set to an https tunnel such as ngrok.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank: callbacks use the address the phone reached the backend on. Set it only to
# force one fixed address, e.g. an https tunnel.
PUBLIC_BASE_URL=