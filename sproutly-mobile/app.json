{
  "name": "Sproutly",
  "slug": "sproutly",
  "version": "1.0.0",
  "scheme": "sproutly",
  "icon": "./assets/images/sproutly-logo.png",
  "android": {
    "package": "app.sproutly.mobile",
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/sproutly-logo.png",
      "backgroundColor": "#12291F"
    }
  },
  "plugins": [
    "expo-status-bar",
    "expo-web-browser",
    "expo-secure-store",
    [
      "expo-location",
      {
        "locationWhenInUsePermission": "Sproutly uses your location once to find your county. It is not kept."
      }
    ],
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/sproutly-logo.png",
        "imageWidth": 220,
        "resizeMode": "contain",
        "backgroundColor": "#1B3D2F"
      }
    ]
  ],
  "extra": {
    "eas": {
      "projectId": "e90e87b3-afd9-4739-83f7-7d33065950b5"
    }
  },
  "owner": "billiart"
}
